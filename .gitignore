# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.dyad/
.venv/
.env*

# Supabase CLI local project linkage
supabase/.temp/

# Release signing key material -- must never be committed. The GitHub Actions
# release workflow decodes this from a repo secret at build time and deletes it
# again afterwards; see .github/workflows/release.yml
*.jks
*.keystore
android/app/release-signing.jks

# pnpm is the package manager (see packageManager in package.json); an npm
# lockfile would drift from pnpm-lock.yaml and skip pnpm's patchedDependencies.
/package-lock.json

# TypeScript incremental build info (tsc -b)
*.tsbuildinfo

# Large binaries kept out of git (C6-08). iOS pulls SQLCipher via SPM from
# github.com/sqlcipher/SQLCipher.swift (see project.pbxproj), so the vendored
# xcframework and its zip are dead weight.
/SQLCipher_Framework/
/SQLCipher.xcframework.zip
*.mp4
