{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        }
      ]
    },
    "window-state:default",
    "notification:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "deep-link:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
