{
  "name": "@openkeep/mcp-server",
  "version": "0.2.0",
  "description": "MCP server for Open Keep. Bridges an AI tool to your notes via an Open Keep tab running on the same machine.",
  "license": "AGPL-3.0",
  "type": "module",
  "private": true,
  "bin": {
    "openkeep-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node test/mock-roundtrip.mjs",
    "pack:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.5.3",
    "@anthropic-ai/mcpb": "^2.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
