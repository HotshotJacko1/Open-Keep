<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/white"
    android:padding="0dp">

    <!-- Left: New Text Note button -->
    <LinearLayout
        android:id="@+id/widget_btn_new_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/white"
        android:padding="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_plus"
            android:contentDescription="New text note" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="New Note"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <!-- Right: New List Note button -->
    <LinearLayout
        android:id="@+id/widget_btn_new_list"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/white"
        android:padding="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_checkbox"
            android:contentDescription="New list note" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="New List"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</LinearLayout>