<?xml version="1.0" encoding="utf-8"?>
<!--
    Single Note widget setup screen. The page colour comes from Theme.OpenKeep.WidgetConfigure.
    fitsSystemWindows replaces a view's own padding with the system bar insets, so it sits
    on this outer frame and the page margins go on the LinearLayout inside.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a note to display"
            android:textSize="22sp"
            android:textColor="@color/widget_heading"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/config_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading notes..."
            android:textSize="14sp"
            android:textColor="@color/widget_text_secondary"
            android:gravity="center"
            android:padding="24dp" />

        <ListView
            android:id="@+id/config_notes_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbarStyle="outsideOverlay" />

    </LinearLayout>
</FrameLayout>
