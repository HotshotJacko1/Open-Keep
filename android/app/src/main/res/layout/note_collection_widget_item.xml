<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Note Title -->
    <TextView
        android:id="@+id/widget_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#202124"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Note Content Preview (for non-checklist content) -->
    <TextView
        android:id="@+id/widget_note_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="#5F6368"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Checkbox Row 1 -->
    <LinearLayout
        android:id="@+id/widget_checkbox_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_checkbox_icon_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_checkbox_text_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#3C4043"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Checkbox Row 2 -->
    <LinearLayout
        android:id="@+id/widget_checkbox_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_checkbox_icon_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_checkbox_text_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#3C4043"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Checkbox Row 3 -->
    <LinearLayout
        android:id="@+id/widget_checkbox_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_checkbox_icon_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_checkbox_text_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#3C4043"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- "More items" indicator -->
    <TextView
        android:id="@+id/widget_more_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#80868B"
        android:paddingTop="2dp"
        android:visibility="gone" />

</LinearLayout>