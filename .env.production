# Public OAuth client IDs, tracked so CI and F-Droid builds get them (C4-15).
# Every VITE_ value is compiled into the client bundle, so nothing here is
# secret. Secrets (SENTRY_AUTH_TOKEN) belong in the untracked .env.local.
# Vite reads this over .env and .env.local; use .env.production.local to override.
VITE_GOOGLE_CLIENT_ID=889284625804-5prnhudcoalopvn0ad0au449lo1bn8f8.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=9e205f3f-77ad-418d-8819-fc62fbbff7d6
VITE_DROPBOX_CLIENT_ID=qhpjwhmjzncis38
